# ── Supabase ─────────────────────────────────────────────────────────────────
# Trovi questi valori in: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key (segreta! bypassa RLS) — usata solo dal pannello admin per leggere le RSVP
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Resend ────────────────────────────────────────────────────────────────────
# Trovi la API key in: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Admin ─────────────────────────────────────────────────────────────────────
# La tua email: riceverai una notifica per ogni nuova RSVP
ADMIN_EMAIL=tua@email.it
# Password per accedere a /admin e vedere le RSVP
ADMIN_PASSWORD=cambia-questa-password
